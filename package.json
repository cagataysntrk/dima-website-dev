{
  "name": "@upcytech/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.9",
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "postinstall": "bun scripts/link-design-system.ts && bun scripts/copy-maplibre-worker.ts",
    "dev": "bun scripts/link-design-system.ts && next dev --webpack -p 3000",
    "build": "bun scripts/link-design-system.ts && next build --webpack",
    "start": "next start",
    "typecheck": "bun scripts/link-design-system.ts && next typegen && tsc --noEmit",
    "test": "bun test tests/content.test.ts tests/guards.test.ts tests/responsive.test.ts tests/team-assets.test.ts tests/chat-demo.test.ts",
    "check": "bun run test && bun run typecheck",
    "test:e2e": "playwright test",
    "capture:screens": "bun scripts/capture-product-screens.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "^3",
    "@mdx-js/react": "^3",
    "@next/mdx": "16.3.5",
    "border-beam": "1.4.0",
    "cobe": "^2.0.1",
    "geist": "^1",
    "gsap": "^3.13.0",
    "lucide-react": "^0.468",
    "maplibre-gl": "^6",
    "motion": "^12",
    "next": "16.3.5",
    "next-intl": "^4.14.5",
    "nodemailer": "^10",
    "posthog-js": "^1",
    "postprocessing": "^6.39",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5",
    "thinking-orbs": "0.3.2",
    "three": "^0.186",
    "zod": "^4"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5",
    "@fontsource/plus-jakarta-sans": "^5",
    "@fontsource/source-serif-4": "^5",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "^1.3.0",
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/nodemailer": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "typescript": "^5.7.0"
  }
}
