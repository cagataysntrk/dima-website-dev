# Copy to .env.local (never committed) and fill in.

# Production origin, used for canonical and hreflang URLs.
NEXT_PUBLIC_SITE_URL=https://usedima.com

# Analytics (src/lib/analytics.ts). Starts only after cookie consent; without a key it never
# starts at all. The EU host keeps data in the EU — confirm the region in the KVKK notice.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Contact form delivery over SMTP (src/app/[locale]/contact/actions.ts).
# Port 465 uses implicit TLS; 587 uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# The mailbox that receives enquiries, and the address they are sent from.
CONTACT_TO=
CONTACT_FROM=
